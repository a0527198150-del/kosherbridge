<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-feature
        android:name="android.hardware.bluetooth"
        android:required="true" />

    <!-- Classic Bluetooth (legacy, API <= 30) -->
    <uses-permission
        android:name="android.permission.BLUETOOTH"
        android:maxSdkVersion="30" />
    <uses-permission
        android:name="android.permission.BLUETOOTH_ADMIN"
        android:maxSdkVersion="30" />
    <!-- Android 12+ runtime permissions -->
    <uses-permission
        android:name="android.permission.BLUETOOTH_SCAN"
        android:usesPermissionFlags="neverForLocation" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <!-- Location is required to discover nearby devices only on API <= 30 -->
    <uses-permission
        android:name="android.permission.ACCESS_FINE_LOCATION"
        android:maxSdkVersion="30" />

    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.READ_CONTACTS" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />
    <!-- Prevent Doze from suspending Bluetooth when the screen is off on
         MediaTek devices (Jelly2). Without this, the system can put the app
         in a standby bucket that freezes network and radio access. -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <!-- Call audio techniques: routing the conversation (mic + speaker) to the
         hands-free device, and recording briefly for the mic diagnostic. -->
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <!-- Privileged permission: allows full HFP control (dial/answer/AT commands).
         Ignored on stock devices; enables the full experience on system-signed
         players / custom ROMs. -->
    <uses-permission
        android:name="android.permission.BLUETOOTH_PRIVILEGED"
        tools:ignore="ProtectedPermissions" />

    <!-- Package visibility (Android 11+). Anything not listed here is invisible
         to this app: getLaunchIntentForPackage returns null, resolveActivity
         returns null, and getServiceInfo throws NameNotFoundException - all of
         which look exactly like "not installed". Every package and action the
         app interrogates has to be declared, or the feature silently vanishes
         on every modern player. -->
    <queries>
        <!-- The capability probe asks whether the Bluetooth stack even declares
             HeadsetClientService. Without this the query returns "not found" on
             every player and the probe cannot tell "the profile is disabled"
             (fixable) apart from "the manufacturer removed it" (hopeless). -->
        <package android:name="com.android.bluetooth" />

        <!-- Shizuku. The readiness screen offers "פתח את Shizuku" when it is
             installed and the store/website only when it is not; undeclared,
             getLaunchIntentForPackage always returned null and the button sent
             users to install something they already had. -->
        <package android:name="moe.shizuku.privileged.api" />

        <!-- Vendor auto-start managers. On these players an app missing from
             that list is killed no matter what Android's own settings say, so
             the readiness screen offers the vendor screen when it exists. Each
             is resolved before being offered - and undeclared, every one of
             them resolved to null, so the row never appeared on precisely the
             devices it was written for. -->
        <package android:name="com.miui.securitycenter" />
        <package android:name="com.letv.android.letvsafe" />
        <package android:name="com.huawei.systemmanager" />
        <package android:name="com.coloros.safecenter" />
        <package android:name="com.oppo.safe" />
        <package android:name="com.iqoo.secure" />
        <package android:name="com.vivo.permissionmanager" />
        <package android:name="com.samsung.android.lool" />
        <package android:name="com.asus.mobilemanager" />

        <!-- The battery-optimisation exemption dialog: the app prefers the
             targeted one and falls back to the full system list, and that
             choice is made with resolveActivity. -->
        <intent>
            <action android:name="android.settings.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
        </intent>
        <!-- Store page / project site, for installing Shizuku. -->
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="market" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="https" />
        </intent>
    </queries>

    <application
        android:name=".BridgeApp"
        android:allowBackup="true"
        android:icon="@drawable/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.KosherBridge">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.KosherBridge">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Full-screen incoming call screen (shows above the lock screen) -->
        <activity
            android:name=".IncomingCallActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:launchMode="singleInstance"
            android:showWhenLocked="true"
            android:theme="@style/Theme.KosherBridge"
            android:turnScreenOn="true" />

        <service
            android:name=".BridgeService"
            android:exported="false"
            android:foregroundServiceType="connectedDevice" />

        <receiver
            android:name=".BootReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <!-- Fast-boot implementations on cheap players send these
                     instead of BOOT_COMPLETED. -->
                <action android:name="android.intent.action.QUICKBOOT_POWERON" />
                <action android:name="com.htc.intent.action.QUICKBOOT_POWERON" />
            </intent-filter>
            <!-- An app update kills the service; without this the bridge stays
                 dead until someone opens the app by hand. -->
            <intent-filter>
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <!-- Restarts the bridge when a vendor "power manager" killed it and
             did not honour START_STICKY. See BridgeWatchdog. -->
        <receiver
            android:name=".BridgeWatchdog$WatchdogReceiver"
            android:exported="false" />

        <!-- Shizuku: receives the binder from the Shizuku server (adb/root).
             Required by the dev.rikka.shizuku:provider dependency. -->
        <provider
            android:name="rikka.shizuku.ShizukuProvider"
            android:authorities="${applicationId}.shizuku"
            android:multiprocess="false"
            android:enabled="true"
            android:exported="true"
            android:permission="android.permission.INTERACT_ACROSS_USERS_FULL" />

        <!-- Root channel: receives the privileged bridge binder from the app's
             own root process (spawned via su + app_process, uid 0). The
             provider is exported so that root process can hand the binder
             over; access is gated inside call() by requiring uid 0 + the
             one-time token generated by RootBridge.start(). -->
        <provider
            android:name=".bluetooth.RootBridgeProvider"
            android:authorities="${applicationId}.rootbridge"
            android:exported="true" />
    </application>

</manifest>
