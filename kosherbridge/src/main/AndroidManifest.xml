<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-feature
        android:name="android.hardware.bluetooth"
        android:required="true" />
    <!-- CALL_PHONE below implies android.hardware.telephony, and an implied
         feature is REQUIRED unless it is declared otherwise. This app runs on
         the player, which by definition has no SIM and no telephony - the
         phone is the other end of the Bluetooth link. Leaving the implication
         in place would tell every store and MDM that the app is incompatible
         with exactly the devices it was written for. -->
    <uses-feature
        android:name="android.hardware.telephony"
        android:required="false" />

    <!-- Classic Bluetooth (legacy, API <= 30) -->
    <uses-permission
        android:name="android.permission.BLUETOOTH"
        android:maxSdkVersion="30" />
    <uses-permission
        android:name="android.permission.BLUETOOTH_ADMIN"
        android:maxSdkVersion="30" />
    <!-- Android 12+ runtime permissions -->
    <uses-permission
        android:name="android.permission.BLUETOOTH_SCAN"
        android:usesPermissionFlags="neverForLocation" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <!-- Location is required to discover nearby devices only on API <= 30 -->
    <uses-permission
        android:name="android.permission.ACCESS_FINE_LOCATION"
        android:maxSdkVersion="30" />

    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.READ_CONTACTS" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />
    <!-- Prevent Doze from suspending Bluetooth when the screen is off on
         MediaTek devices (Jelly2). Without this, the system can put the app
         in a standby bucket that freezes network and radio access. -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <!-- Call audio techniques: routing the conversation (mic + speaker) to the
         hands-free device, and recording briefly for the mic diagnostic. -->
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <!-- TELECOM channel: the only path to call AUDIO without root, Shizuku or a
         Magisk module. The player's own Bluetooth stack connects to the kosher
         phone with the HFP-Client profile; AOSP's HfpClientConnectionService
         publishes those calls into Telecom, and these four ordinary runtime
         permissions are enough to see and drive them:
           READ_PHONE_STATE   - observe ringing / in-call / idle
           READ_CALL_LOG      - caller ID in that broadcast (Android 9+ gates
                                the number behind this; without it calls still
                                appear, just without a number)
           ANSWER_PHONE_CALLS - accept a ringing call, reject / hang up
           CALL_PHONE         - place a call through the phone's PhoneAccount
         None of these is privileged; all are granted by the user in a dialog. -->
    <uses-permission android:name="android.permission.READ_PHONE_STATE" />
    <uses-permission android:name="android.permission.READ_CALL_LOG" />
    <uses-permission android:name="android.permission.ANSWER_PHONE_CALLS" />
    <uses-permission android:name="android.permission.CALL_PHONE" />

    <!-- Privileged permission: allows full HFP control (dial/answer/AT commands).
         Ignored on stock devices; enables the full experience on system-signed
         players / custom ROMs. -->
    <uses-permission
        android:name="android.permission.BLUETOOTH_PRIVILEGED"
        tools:ignore="ProtectedPermissions" />

    <application
        android:name=".BridgeApp"
        android:allowBackup="true"
        android:icon="@drawable/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.KosherBridge">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.KosherBridge">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Full-screen incoming call screen (shows above the lock screen) -->
        <activity
            android:name=".IncomingCallActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:launchMode="singleInstance"
            android:showWhenLocked="true"
            android:theme="@style/Theme.KosherBridge"
            android:turnScreenOn="true" />

        <service
            android:name=".BridgeService"
            android:exported="false"
            android:foregroundServiceType="connectedDevice" />

        <receiver
            android:name=".BootReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <!-- Shizuku: receives the binder from the Shizuku server (adb/root).
             Required by the dev.rikka.shizuku:provider dependency. -->
        <provider
            android:name="rikka.shizuku.ShizukuProvider"
            android:authorities="${applicationId}.shizuku"
            android:multiprocess="false"
            android:enabled="true"
            android:exported="true"
            android:permission="android.permission.INTERACT_ACROSS_USERS_FULL" />

        <!-- Root channel: receives the privileged bridge binder from the app's
             own root process (spawned via su + app_process, uid 0). The
             provider is exported so that root process can hand the binder
             over; access is gated inside call() by requiring uid 0 + the
             one-time token generated by RootBridge.start(). -->
        <provider
            android:name=".bluetooth.RootBridgeProvider"
            android:authorities="${applicationId}.rootbridge"
            android:exported="true" />
    </application>

</manifest>
